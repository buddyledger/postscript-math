tx@NumericDict begin
/c_z { % any -> [re im]
	dup type /arraytype eq { dup length 2 eq { }{ 0 2 array astore } ifelse }{ 0 2 array astore } ifelse
} bind def
/c_hasbn { aload pop m_isstrbn exch m_isstrbn or } bind def   % [re im] -> bool
/c_1 { % z -> (ops dict, guard and a local dict begun; Z, ar, ai defined)
	c_z dup c_hasbn m_ops begin m_guard
	12 dict begin
	dup /Z exch def
	aload pop m_cv /ai exch def m_cv /ar exch def
} bind def
/c_2 { % a b -> (as c_1; A, B, ar, ai, br, bi defined)
	exch c_z exch c_z
	2 copy c_hasbn exch c_hasbn or m_ops begin m_guard
	14 dict begin
	2 copy /B exch def /A exch def
	aload pop m_cv /bi exch def m_cv /br exch def
	aload pop m_cv /ai exch def m_cv /ar exch def
} bind def
/c_end { % re im -> [re im], closing what c_1 or c_2 opened
	end m_unguard m_fin exch m_fin exch 2 array astore end
} bind def
/c_end1 { end m_unguard m_fin end } bind def   % x -> x, closing a real result
/cpx { 2 array astore } bind def            % re im -> [re im]
/cre { c_z 0 get } bind def                 % z -> re
/cim { c_z 1 get } bind def                 % z -> im
/cadd { c_2 ar br m_add ai bi m_add c_end } bind def
/csub { c_2 ar br m_sub ai bi m_sub c_end } bind def
/cmul {
	c_2
	ar br m_mul ai bi m_mul m_sub
	ar bi m_mul ai br m_mul m_add
	c_end
} bind def
/cdiv {
	c_2
	/d br br m_mul bi bi m_mul m_add def
	d m_isz { A B end m_unguard end /cdiv errordict /undefinedresult get exec } if
	ar br m_mul ai bi m_mul m_add d m_div
	ai br m_mul ar bi m_mul m_sub d m_div
	c_end
} bind def
/cneg  { c_1 ar m_neg ai m_neg c_end } bind def
/cconj { c_1 ar ai m_neg c_end } bind def
/cabs  { c_1 ar ar m_mul ai ai m_mul m_add m_sqrt c_end1 } bind def   % z -> |z|
/carg  { c_1 ai ar m_atan2 c_end1 } bind def                         % z -> angle in (-pi, pi]
/cexp { % e^(a+bi) = e^a (cos b + i sin b)
	c_1
	/r ar m_exp def
	r ai m_cos m_mul r ai m_sin m_mul
	c_end
} bind def
/cln { % principal logarithm: ln|z| + i arg z
	c_1
	ar m_isz ai m_isz and { Z end m_unguard end /cln errordict /rangecheck get exec } if
	ar ar m_mul ai ai m_mul m_add m_ln m_two m_div
	ai ar m_atan2
	c_end
} bind def
/csqrt { % principal square root, real part >= 0
	c_1
	ar m_isz ai m_isz and { m_zero m_zero }{
		/r ar ar m_mul ai ai m_mul m_add m_sqrt def
		ar m_isneg {
			/t r ar m_sub m_two m_div m_sqrt def          % |imaginary part|
			ai m_abs m_two t m_mul m_div
			ai m_isneg { t m_neg }{ t } ifelse
		}{
			/t r ar m_add m_two m_div m_sqrt def          % real part
			t  ai m_two t m_mul m_div
		} ifelse
	} ifelse
	c_end
} bind def
/cpow { % z w -> z^w (principal value)
	exch c_z exch c_z
	2 copy c_hasbn exch c_hasbn or m_ops begin m_guard
	12 dict begin
	/W exch def /Z exch def
	/z [ Z aload pop m_cv exch m_cv exch ] def
	/w [ W aload pop m_cv exch m_cv exch ] def
	/zero z 0 get m_isz z 1 get m_isz and def
	w 1 get m_isz w 0 get m_isint and w 0 get m_abs 1000000 m_cv m_lt and {
		/n w 0 get m_toint def
		zero n 0 lt and { Z W end m_unguard end /cpow errordict /undefinedresult get exec } if
		/r [ m_one m_zero ] def /b z def /m n abs def
		{ m 0 eq { exit } if
		  m 2 mod 1 eq { /r r b cmul def } if
		  /m m 2 idiv def
		  m 0 gt { /b b b cmul def } if
		} loop
		n 0 lt { [ m_one m_zero ] r cdiv }{ r } ifelse
	}{
		zero {
			w 0 get m_isneg w 0 get m_isz or { Z W end m_unguard end /cpow errordict /undefinedresult get exec } if
			[ m_zero m_zero ]
		}{ z cln w cmul cexp } ifelse
	} ifelse
	aload pop c_end
} bind def
/csin  { c_1 ar m_sin ai m_cosh m_mul  ar m_cos ai m_sinh m_mul  c_end } bind def
/ccos  { c_1 ar m_cos ai m_cosh m_mul  ar m_sin ai m_sinh m_mul m_neg  c_end } bind def
/csinh { c_1 ar m_sinh ai m_cos m_mul  ar m_cosh ai m_sin m_mul  c_end } bind def
/ccosh { c_1 ar m_cosh ai m_cos m_mul  ar m_sinh ai m_sin m_mul  c_end } bind def
/c_isreal { m_one type /integertype eq } bind def   % -> true for real arithmetic
/ctan { % (sin 2a + i sinh 2b) / (cos 2a + cosh 2b)
	c_1
	c_isreal { ai abs 20 gt }{ false } ifelse { m_zero ai 0 lt { -1 }{ 1 } ifelse }{
		/d ar m_two m_mul m_cos ai m_two m_mul m_cosh m_add def
		d m_isz { Z end m_unguard end /ctan errordict /undefinedresult get exec } if
		ar m_two m_mul m_sin d m_div  ai m_two m_mul m_sinh d m_div
	} ifelse
	c_end
} bind def
/ctanh { % (sinh 2a + i sin 2b) / (cosh 2a + cos 2b)
	c_1
	c_isreal { ar abs 20 gt }{ false } ifelse { ar 0 lt { -1 }{ 1 } ifelse m_zero }{
		/d ar m_two m_mul m_cosh ai m_two m_mul m_cos m_add def
		d m_isz { Z end m_unguard end /ctanh errordict /undefinedresult get exec } if
		ar m_two m_mul m_sinh d m_div  ai m_two m_mul m_sin d m_div
	} ifelse
	c_end
} bind def
/c_rasinh { % x -> asinh x for a real x (ops dict current)
	4 dict begin /x exch def
	x m_isneg { x m_neg c_rasinh m_neg }{ x m_isz { m_zero }{
	c_isreal {
		x 0.1 lt { x dup dup mul dup dup -5 112 div mul 3 40 div add mul -1 6 div add mul 1 add mul }
		{ x dup dup mul 1 add sqrt add ln } ifelse
	}{
		/bnn bnn x bn_lead neg 0 bn_max add def          % digits lost near 0
		x x x m_mul m_one m_add m_sqrt m_add m_ln
	} ifelse } ifelse } ifelse
	end
} bind def
/c_ratanh { % x -> atanh x for a real x, |x| < 1 (ops dict current)
	4 dict begin /x exch def
	x m_isneg { x m_neg c_ratanh m_neg }{ x m_isz { m_zero }{
	c_isreal {
		x 0.1 lt { x dup dup mul dup dup 1 7 div mul 1 5 div add mul 1 3 div add mul 1 add mul }
		{ 1 x add 1 x sub div ln 2 div } ifelse
	}{
		/bnn bnn x bn_lead neg 0 bn_max add def
		m_one x m_add m_one x m_sub m_div m_ln m_two m_div
	} ifelse } ifelse } ifelse
	end
} bind def
/c_unit { ai m_isz ar m_abs m_one m_gt not and } bind def   % z real, |z| <= 1
/casin { % -i ln(iz + sqrt(1 - z^2))
	c_1
	c_unit { ar m_one ar ar m_mul m_sub m_sqrt m_atan2 m_zero }{
	ai m_isz { % real |x| > 1: +-pi/2 + i acosh|x|, as C99 and Python
		m_pi m_two m_div ar m_isneg { m_neg } if
		ar m_abs dup dup m_mul m_one m_sub m_sqrt m_add m_ln
