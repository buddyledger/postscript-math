/sp_isbn { dup type /stringtype eq exch bn_isbnshape or } bind def
/sp_call { % x {proc} -> proc of x: at bnn for a bignum or string, as a real for a number
	1 index sp_isbn { exec }{
		4 dict begin /bnn 12 def exch setbn exch
		stopped { end $error /command get errordict $error /errorname get get exec } if
		end bncvr
	} ifelse
} bind def
/sp_extra { bn_lead 0 bn_max } bind def                 % x -> digits before the point, less 1
/sp_lgpos { % x > 0 -> ln Gamma(x)   (at the current bnn)
16 dict begin
	/x exch def /z0 bnn 10 bn_max def
	{
		x z0 setbn gebn { /N 0 def }{ /N z0 x bncvr floor cvi sub def } ifelse
		/z x N setbn addbn def
		/main z (0.5) setbn subbn z lnbn mulbn z subbn
		      pibn 2 setbn mulbn lnbn 2 setbn divbn addbn def
		/zi 1 setbn z divbn def /zi2 zi zi mulbn def
		/sum 0 setbn def /pw zi def /ok false def
		0 1 59 { /k exch def
			/kk k 1 add 2 mul def
			/term sp_bern k 2 mul get setbn sp_bern k 2 mul 1 add get setbn divbn
			      kk kk 1 sub mul setbn divbn pw mulbn def
			/sum sum term addbn def
			term main bn_tiny { /ok true def exit } if
			/pw pw zi2 mulbn def
		} for
		ok { exit } if
		/z0 z0 2 mul def                                % more shift, the series converges faster
	} loop
	main sum addbn
	N 0 gt {
		1 setbn 0 1 N 1 sub { setbn x addbn mulbn } for lnbn subbn
	} if
end
} bind def
/sp_gpos { % x > 0 -> Gamma(x), with digits enough for exp of ln Gamma
	dup sp_extra 2 mul 3 add { sp_lgpos expbn } bn_prec
} bind def
/sp_gamma { % x -> Gamma(x)
8 dict begin
	setbn /x exch def
	x bn_isint {
		x bn_isneg x bniszero or { x end /gamma errordict /undefinedresult get exec } if
		x bn_lead 4 lt { x bn_toint 1 sub factbn }{ x sp_gpos } ifelse
	}{
		x bn_isneg not { x sp_gpos }{
			x dup sp_extra 2 mul 2 add {
				/y exch def pibn  y pibn mulbn sinbn  1 setbn y subbn sp_gpos mulbn  divbn
			} bn_prec
		} ifelse
	} ifelse
end
} bind def
/sp_lngamma { % x -> ln |Gamma(x)|
8 dict begin
	setbn /x exch def
	x bn_isint {
		x bn_isneg x bniszero or { x end /lngamma errordict /undefinedresult get exec } if
		x bn_lead 4 lt { x 0 { bn_toint 1 sub factbn lnbn } bn_prec }{ x 2 { sp_lgpos } bn_prec } ifelse
	}{
		x bn_isneg not { x 2 { sp_lgpos } bn_prec }{
			x dup sp_extra 2 mul 2 add {
				/y exch def pibn lnbn  y pibn mulbn sinbn absbn lnbn subbn  1 setbn y subbn sp_lgpos subbn
			} bn_prec
		} ifelse
	} ifelse
end
} bind def
/gamma { { sp_gamma } sp_call } bind def        % x -> Gamma(x); undefinedresult for 0, -1, -2, ...
/lngamma { { sp_lngamma } sp_call } bind def    % x -> ln |Gamma(x)|
/sp_erfser { % x -> erf x by a series of positive terms   (at the current bnn)
8 dict begin
	/x exch def /x2 x x mulbn 2 setbn mulbn def
	/t x def /sum x def /n 0 def
	{ /n n 1 add def
	  /t t x2 mulbn n 2 mul 1 add bn_divint def
	  /sum sum t addbn def
	  t sum bn_tiny { exit } if
	} loop
	2 setbn pibn sqrtbn divbn  x x mulbn negbn expbn mulbn  sum mulbn
end
} bind def
/sp_erfccf { % x > 0 -> erfc x by a continued fraction   (at the current bnn)
10 dict begin
	/x exch def /one 1 setbn def
	/f x def /C x def /D 0 setbn def /n 0 def
	{ /n n 1 add def
	  /a n setbn 2 setbn divbn def
	  /D one x a D mulbn addbn divbn def
	  /C x a C divbn addbn def
	  /dl C D mulbn def
	  /f f dl mulbn def
	  dl one subbn one bn_tiny n 100000 gt or { exit } if
	} loop
	x x mulbn negbn expbn  pibn sqrtbn f mulbn  divbn
end
} bind def
/sp_xc { bnn sqrt 2 div 2 bn_max } bind def      % below: series, above: continued fraction
/sp_big { bn_lead 3 gt } bind def                 % |x| >= 10000
/sp_erf { % x -> erf x
8 dict begin
	setbn /x exch def /ax x absbn def
	ax bniszero { 0 setbn }{
		ax sp_big { 1 setbn }{ ax bncvr sp_xc lt { ax 0 { sp_erfser } bn_prec }{
			ax 0 { 1 setbn exch sp_erfccf subbn } bn_prec } ifelse } ifelse
		x bn_isneg { negbn } if
	} ifelse
end
} bind def
/sp_erfcpos { % x >= 0 -> erfc x
	dup sp_big { pop 0 setbn }{
	dup bncvr sp_xc lt {
		dup bncvr dup mul 0.4343 mul ceiling cvi 1 add { 1 setbn exch sp_erfser subbn } bn_prec
	}{ 0 { sp_erfccf } bn_prec } ifelse } ifelse
} bind def
/sp_erfc { % x -> erfc x
	setbn dup bn_isneg { absbn sp_erfcpos 2 setbn exch subbn }{ sp_erfcpos } ifelse
} bind def
/erf { { sp_erf } sp_call } bind def            % x -> erf x
/erfc { { sp_erfc } sp_call } bind def          % x -> 1 - erf x, accurate in the tail
/sp_normpdf { % x -> e^(-x^2/2) / sqrt(2 pi)
	setbn 0 { dup mulbn negbn 2 setbn divbn expbn pibn 2 setbn mulbn sqrtbn divbn } bn_prec
} bind def
/sp_normcdf { % x -> P(X <= x) = erfc(-x / sqrt 2) / 2
	setbn 2 { negbn 2 setbn sqrtbn divbn sp_erfc 2 setbn divbn } bn_prec
