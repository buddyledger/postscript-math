} bind def
/sp_norminv { % p (0 < p < 1) -> x with P(X <= x) = p
10 dict begin
	setbn /p exch def
	p bniszero p bn_isneg or p 1 setbn gebn or { p end /norminv errordict /rangecheck get exec } if
	p (0.5) setbn eqbn { 0 setbn }{
	p (0.5) setbn gtbn { 1 setbn p subbn sp_norminv negbn }{
		p 2 {
			/q exch def
			q bn_lead -30 lt {
				q lnbn -2 setbn mulbn dup dup lnbn subbn pibn 2 setbn mulbn lnbn subbn sqrtbn negbn
			}{ q bncvr sp_acklam setbn } ifelse
			/x exch def /lq q lnbn def
			0 1 60 { pop                                % Newton steps for ln P(X <= x) = ln p
				/c x sp_normcdf def
				/dx c lnbn lq subbn c mulbn x sp_normpdf divbn def
				/x x dx subbn def
				dx bn_lead x bn_lead bnn 4 sub sub lt { exit } if   % within the guard digits
			} for
			x
		} bn_prec
	} ifelse } ifelse
end
} bind def
/normpdf { { sp_normpdf } sp_call } bind def    % x -> density of the standard normal distribution
/normcdf { { sp_normcdf } sp_call } bind def    % x -> its distribution function
/norminv { { sp_norminv } sp_call } bind def    % p -> its quantile; rangecheck unless 0 < p < 1
/sp_besselj { % n x -> J_n(x)   (n an integer)
12 dict begin
	setbn /x exch def /n exch def
	/sg 1 def
	n 0 lt { /n n neg def n 2 mod 1 eq { /sg sg neg def } if } if
	x bn_isneg { /x x absbn def n 2 mod 1 eq { /sg sg neg def } if } if
	x bn_lead 5 gt { n x end /besselj errordict /rangecheck get exec } if
	x bniszero { n 0 eq { 1 }{ 0 } ifelse setbn }{
		x x bncvr 0.4343 mul ceiling cvi 2 add {
			/h exch 2 setbn divbn def /h2 h h mulbn def
			/t h n setbn powbn n factbn divbn def
			/sum t def /tmax t absbn def /k 0 def
			{ /k k 1 add def
			  /t t h2 mulbn k k n add mul bn_divint negbn def
			  /sum sum t addbn def
			  t absbn tmax gtbn { /tmax t absbn def } if
			  t tmax bn_tiny { exit } if
			} loop
			sum
		} bn_prec
		sg 0 lt { negbn } if
	} ifelse
end
} bind def
/besselj { % n x -> Bessel function J_n(x) of the first kind, for an integer n
	1 index type /integertype ne { /besselj errordict /typecheck get exec } if
	{ sp_besselj } sp_call
} bind def
