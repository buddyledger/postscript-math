				n_fu n_fv m_gt not n_v n_x m_sub m_isz or n_v n_w m_sub m_isz or {
					/n_v n_u def /n_fv n_fu def } if
			} ifelse
		} ifelse
	} for
	n_x
	end m_unguard m_fin end
} bind def
/fderiv {
