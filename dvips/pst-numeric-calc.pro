		n_x n_hc m_add n_f m_cv  n_x n_hc m_sub n_f m_cv  m_sub  n_hc m_two m_mul m_div } def
	/n_hh n_x m_abs m_one n_max 10 m_cv m_div def
	/n_tab n_ntab array def
