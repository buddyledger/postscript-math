	/lv exch def /o exch def
	S length lv sub 1 eq {
		[ 0 1 S lv get 1 sub { o add D exch get m_cv m_str } for ] (, ) t_join
	}{
		S length lv sub 2 eq {
			[ 0 1 S lv get 1 sub { ST lv get mul o add /ro exch def
				[ 0 1 S lv 1 add get 1 sub { ro add D exch get m_cv m_str } for ] ( ) t_join
			} for ] (; ) t_join
		}{
			[ 0 1 S lv get 1 sub { ST lv get mul o add lv 1 add t_cv } for ] (, ) t_join
		} ifelse
	} ifelse
	([) exch t_cat (]) t_cat
	end
} bind def
/tPrint {
	dup t_isT not { /tPrint errordict /typecheck get exec } if
	dup /shape get length 2 eq { ttomatrix mPrint }{ tcvs = } ifelse
} bind def
end % tx@NumericDict
