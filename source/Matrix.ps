% Every name is defined in tx@NumericDict, so that nothing clashes with other
% PostScript code. Load.ps leaves the dictionary open; after loading a file
% on its own, use  tx@NumericDict begin ... end  around calls.
/tx@NumericDict where { pop }{ /tx@NumericDict 1000 dict def } ifelse
tx@NumericDict begin
% Version 1.1 (2026): added mfromrows, mtorows, mcopy, midentity, mtranspose,
% madd, msub, mscale, mdet, minv, msolve, mlstsq, meigsym and mPrint. Every
% operation accepts bignum elements when bignumlibrary.ps is loaded.
%

%M i j Val
/mput { exch dup 5 -1 roll 
        dup 4 -1 roll 1 sub get 3 -2 roll 
        exch 5 -3 roll dup 4 2 roll 
        exch 1 sub exch put 
        exch 1 sub exch put
} def 

%M i j
/mget {3 -1 roll exch 1 sub get exch 1 sub get} def

%/M m n marray def 
/marray {
10 dict begin
/n exch def /m exch def
/A n array def % array of cols
0 1 n 1 sub {/i exch def A i m array put} for %insert arrays of rows
1 1 m {/i exch def
    1 1 n {/j exch def
    A i j 0 mput
    } for 
} for
A
end
} bind def

/msize {dup length exch 0 get length exch} bind def % M -> m n (rows, then columns on top) 


% ---------------------------------------------------------------- arithmetic
% Every operation below works on plain numbers. If any element is a bignum
% (bignumlibrary.ps), the whole calculation switches to bignum arithmetic at
% the current precision bnn. Numbers in the matrix are converted with setbn,
% and so are strings, so [[(0.1) (0.2)] [(0.3) (0.4)]] mfromrows is an exact
% decimal matrix. Names starting with m_ are internal.

/m_isbn { % any -> bool (has the shape of a bignum)
	dup type /arraytype eq {
		dup length 3 eq {
			dup 0 get type /booleantype eq
			1 index 1 get type /stringtype eq and
			exch 2 get type /integertype eq and
		}{ pop false } ifelse
	}{ pop false } ifelse
} bind def

% M -> bool: true if any element is a bignum or a string such as (0.1),
% which is then read with setbn
/m_hasbn { false exch { { dup type /stringtype eq exch m_isbn or or } forall } forall } bind def
/m_allint { true exch { { type /integertype eq and } forall } forall } bind def

% Two sets of the same operations; m_ops picks one to put on the dict stack.
/m_realops 40 dict def
m_realops begin
	/m_add { add } def  /m_sub { sub } def  /m_mul { mul } def  /m_div { div } def
	/m_neg { neg } def  /m_abs { abs } def  /m_gt { gt } def    /m_isz { 0 eq } def
	/m_cv { } def       /m_zero { 0 } def   /m_one { 1 } def
	/m_eps { 1e-5 } def                     % relative size of a "zero" pivot
	/m_guard { } def    /m_unguard { } def  /m_fin { } def
	/m_str { 30 string cvs } def
	/m_lt { lt } def    /m_isneg { 0 lt } def  /m_two { 2 } def
	/m_tol { 1e-6 } def                     % relative convergence tolerance
	/m_isint { dup round eq } def           /m_toint { round cvi } def
	/m_sqrt { sqrt } def                    /m_ln { ln } def
	/m_exp { 2.718281828459045 exch exp } def
	/m_sin { 57.29577951308232 mul sin } def  /m_cos { 57.29577951308232 mul cos } def
	/m_atan2 { % y x -> angle in radians, (-pi, pi]; 0 for (0, 0)
		2 copy 0 eq exch 0 eq and { pop pop 0.0 }{
			atan dup 180 gt { 360 sub } if 0.017453292519943295 mul } ifelse } def
	/m_pi { 3.141592653589793 } def
	/m_sinh { % series near 0, where e^x - e^-x would lose the digits
		dup abs 0.5 lt { dup dup mul dup dup 5040 div 1 120 div add mul 1 6 div add mul 1 add mul }
		{ 2.718281828459045 exch exp dup 1 exch div sub 2 div } ifelse } def
	/m_cosh { 2.718281828459045 exch exp dup 1 exch div add 2 div } def
end
/m_bnops 40 dict def
m_bnops begin
	/m_add { addbn } def  /m_sub { subbn } def  /m_mul { mulbn } def  /m_div { divbn } def
	/m_neg { negbn } def  /m_abs { absbn } def  /m_gt { gtbn } def    /m_isz { bniszero } def
	/m_cv { setbn } def   /m_zero { 0 setbn } def  /m_one { 1 setbn } def
	/m_eps { bnn 3 sub dup 1 lt { pop 1 } if 10 string cvs (1e-) exch mergestr setbn } def
	% work with 6 extra digits, then round the results back to bnn
	/m_guard { 20 dict begin /bnn bnn 6 add def } def
	/m_unguard { end } def
	/m_fin { bn_renorm } def
	/m_str { bncvs } def
	/m_lt { ltbn } def  /m_isneg { bn_isneg } def  /m_two { 2 setbn } def
	/m_tol { m_eps } def
	/m_isint { bn_isint } def               /m_toint { bn_toint } def
	/m_sqrt { sqrtbn } def                  /m_ln { lnbn } def
	/m_exp { expbn } def
	/m_sin { sinbn } def                    /m_cos { cosbn } def
	/m_atan2 { atan2bn } def
	/m_pi { pibn } def
	/m_sinh { sinhbn } def                  /m_cosh { coshbn } def
end
/m_ops { { m_bnops }{ m_realops } ifelse } bind def   % bool -> dict
/m_isstrbn { dup type /stringtype eq exch m_isbn or } bind def   % any -> bool
/m_finm { [ exch { [ exch { m_fin } forall ] } forall ] } bind def
/m_max { 2 copy m_gt { pop }{ exch pop } ifelse } bind def   % a b -> larger (ops dict current)

% ---------------------------------------------------------------- building

%[ [a b] [c d] ] mfromrows -> M   (a list of rows, all the same length)
/mfromrows {
10 dict begin
	/R exch def
	R type /arraytype ne { R end /mfromrows errordict /typecheck get exec } if
	/m R length def
	m 0 eq { R end /mfromrows errordict /rangecheck get exec } if
	R {
		dup type /arraytype ne { pop R end /mfromrows errordict /typecheck get exec } if
		length R 0 get length ne { R end /mfromrows errordict /rangecheck get exec } if
	} forall
	/n R 0 get length def
	n 0 eq { R end /mfromrows errordict /rangecheck get exec } if
	/A m n marray def
	1 1 m { /i exch def /row R i 1 sub get def
		1 1 n { /j exch def A i j row j 1 sub get mput } for
	} for
	A
end
} bind def

%M mtorows -> [ [row 1] [row 2] ... ]
/mtorows {
10 dict begin
	/A exch def A msize /n exch def /m exch def
	[ 1 1 m { /i exch def [ 1 1 n { /j exch def A i j mget } for ] } for ]
end
} bind def

/mcopy { [ exch { [ exch aload pop ] } forall ] } bind def   % M -> independent copy

%n midentity -> n x n identity matrix
/midentity {
5 dict begin
	/n exch def /I n n marray def
	1 1 n { /i exch def I i i 1 mput } for
	I
end
} bind def

%M mtranspose -> transpose
/mtranspose {
10 dict begin
	/A exch def A msize /n exch def /m exch def
	/T n m marray def
	1 1 m { /i exch def 1 1 n { /j exch def T j i A i j mget mput } for } for
	T
end
} bind def

% ---------------------------------------------------------------- arithmetic

/m_ew { % A B /opname /caller -> C   element by element
	4 2 roll 2 copy m_hasbn exch m_hasbn or m_ops begin
	10 dict begin
	/B exch def /A exch def /who exch def /op exch def
	A msize /n exch def /m exch def
	B msize n ne exch m ne or { A B who end end errordict /rangecheck get exec } if
	/C m n marray def
	1 1 m { /i exch def 1 1 n { /j exch def
		C i j  A i j mget m_cv  B i j mget m_cv  op load exec  mput
	} for } for
	C
	end end
} bind def
/madd { /m_add /madd m_ew } bind def   % A B -> A+B
/msub { /m_sub /msub m_ew } bind def   % A B -> A-B

%M s mscale -> s times M   (s a number or a bignum)
/mscale {
	2 copy dup m_isbn exch type /stringtype eq or exch m_hasbn or m_ops begin
	10 dict begin
	/s exch m_cv def /A exch def
	A msize /n exch def /m exch def
	/C m n marray def
	1 1 m { /i exch def 1 1 n { /j exch def C i j A i j mget m_cv s m_mul mput } for } for
	C
	end end
} bind def

%A B mmul -> A x B   (or the string (Nan) if A's columns don't match B's rows)
/mmul {
	2 copy m_hasbn exch m_hasbn or m_ops begin
	15 dict begin
	/B exch def /A exch def
	A msize /nA exch def /mA exch def
	B msize /nB exch def /mB exch def
	nA mB eq {
		m_guard
		/R mA nB marray def
		1 1 nB { /j exch def
			1 1 mA { /i exch def
				m_zero
				1 1 nA { /k exch def A i k mget m_cv B k j mget m_cv m_mul m_add } for
				/s exch def R i j s mput
			} for
		} for
		R m_unguard m_finm
	}{ (Nan) } ifelse
	end end
} bind def

% ---------------------------------------------------------------- solving

% Gauss-Jordan elimination with partial pivoting on the rows of [A | B].
% The arithmetic dict (m_ops) must be current.
% A B m_gj -> X det true   (A X = B)   or   0 false   (A is singular)
% A pivot counts as zero when it is below m_eps times the largest |element|
% of A, so rounding errors don't hide a singular matrix.
/m_gj {
	m_guard
	20 dict begin
	/B exch def /A exch def
	/n A length def /k B length def /w n k add def
	/W [ 1 1 n { /i exch def
		[ 1 1 n { /j exch def A i j mget m_cv } for
		  1 1 k { /j exch def B i j mget m_cv } for ]
	} for ] def
	m_zero
	1 1 n { /i exch def 1 1 n { /j exch def
		A i j mget m_cv m_abs 2 copy m_gt { pop }{ exch pop } ifelse
	} for } for
	m_eps m_mul /tol exch def
	/det m_one def /ok true def
	0 1 n 1 sub { /c exch def
		/p c def /best W c get c get m_abs def
		c 1 add 1 n 1 sub { /r exch def
			W r get c get m_abs dup best m_gt { /best exch def /p r def }{ pop } ifelse
		} for
		best tol m_gt not { /ok false def exit } if
		p c ne { W p get W c get W exch p exch put W exch c exch put /det det m_neg def } if
		/rowc W c get def /piv rowc c get def
		/det det piv m_mul def
		c 1 w 1 sub { /j exch def rowc j rowc j get piv m_div put } for
		rowc c m_one put
		0 1 n 1 sub { /r exch def r c ne {
			/rowr W r get def /f rowr c get def
			f m_isz not {
				c 1 w 1 sub { /j exch def rowr j  rowr j get f rowc j get m_mul m_sub  put } for
			} if
		} if } for
	} for
	ok {
		/X n k marray def
		1 1 n { /i exch def 1 1 k { /j exch def X i j W i 1 sub get n j add 1 sub get mput } for } for
		X det true
	}{ m_zero false } ifelse
	end
	m_unguard
	{ m_fin exch m_finm exch true }{ m_fin false } ifelse
} bind def

%A mdet -> determinant   (A square)
/mdet {
	dup m_hasbn m_ops begin
	10 dict begin
	/A exch def
	A msize ne { A end end /mdet errordict /rangecheck get exec } if
	A A length 0 marray m_gj { exch pop } if
	% a matrix of integers has an integer determinant
	A m_allint { dup abs 1e9 lt { round cvi } if } if
	end end
} bind def

%A minv -> inverse of A   (A square; undefinedresult if A is singular)
/minv {
	dup m_hasbn m_ops begin
	10 dict begin
	/A exch def
	A msize ne { A end end /minv errordict /rangecheck get exec } if
	A A length midentity m_gj
	{ pop end end }{ pop A end end /minv errordict /undefinedresult get exec } ifelse
} bind def

%A B msolve -> X with A X = B   (A n x n, B n x k; undefinedresult if A is singular)
/msolve {
	2 copy m_hasbn exch m_hasbn or m_ops begin
	10 dict begin
	/B exch def /A exch def
	A msize ne  B msize pop A msize pop ne  or { A B end end /msolve errordict /rangecheck get exec } if
	A B m_gj
	{ pop end end }{ pop A B end end /msolve errordict /undefinedresult get exec } ifelse
} bind def

% ---------------------------------------------------------------- least squares

%A B mlstsq -> X minimising |A X - B|   (A m x n with m >= n, B m x k)
% Householder QR, which is more accurate than solving the normal equations.
% undefinedresult if the columns of A are linearly dependent.
/mlstsq {
	2 copy m_hasbn exch m_hasbn or m_ops begin m_guard
	24 dict begin
	/B exch def /A exch def
	A msize /n exch def /m exch def
	B msize /k exch def /mb exch def
	m n lt mb m ne or { A B end m_unguard end /mlstsq errordict /rangecheck get exec } if
	/Q [ A { [ exch { m_cv } forall ] } forall ] def     % columns of A
	/C [ B { [ exch { m_cv } forall ] } forall ] def     % columns of B
	m_zero A { { m_cv m_abs 2 copy m_gt { pop }{ exch pop } ifelse } forall } forall
	m_eps m_mul /tol exch def
	/ok true def
	0 1 n 1 sub { /j exch def
		/cj Q j get def
		m_zero j 1 m 1 sub { cj exch get dup m_mul m_add } for m_sqrt /nrm exch def
		nrm tol m_gt not { /ok false def exit } if
		/x0 cj j get def
		/alpha x0 m_isneg { nrm }{ nrm m_neg } ifelse def
		/v [ j 1 m 1 sub { cj exch get } for ] def
		v 0 x0 alpha m_sub put
		/vtv m_zero v { dup m_mul m_add } forall def
		% reflect columns j.. of A and every column of B
		[ j 1 n 1 sub { Q exch get } for C aload pop ] { /col exch def
			m_zero 0 1 v length 1 sub { /i exch def v i get col i j add get m_mul m_add } for
			m_two m_mul vtv m_div /s exch def
			0 1 v length 1 sub { /i exch def
				col i j add  col i j add get s v i get m_mul m_sub  put
			} for
		} forall
	} for
	ok not { A B end m_unguard end /mlstsq errordict /undefinedresult get exec } if
	% back substitution with R (upper triangle of the reflected A)
	/X n k marray def
	1 1 k { /c exch def /cc C c 1 sub get def
		n 1 sub -1 0 { /i exch def
			cc i get
			i 1 add 1 n 1 sub { /l exch def Q l get i get X l 1 add c mget m_mul m_sub } for
			Q i get i get m_div
			X i 1 add c 4 -1 roll mput
		} for
	} for
	X
	end m_unguard m_finm end
} bind def

% ---------------------------------------------------------------- eigenvalues

%A meigsym -> [values] V   (A symmetric)
% Eigenvalues in ascending order, and V with the matching unit eigenvectors
% as its columns, so A V = V diag(values). Cyclic Jacobi rotations.
% rangecheck if A is not square and symmetric.
/meigsym {
	dup m_hasbn m_ops begin m_guard
	30 dict begin
	/A exch def A msize /n exch def /m exch def
	m n ne { A end m_unguard end /meigsym errordict /rangecheck get exec } if
	/W [ 1 1 n { /i exch def [ 1 1 n { /j exch def A i j mget m_cv } for ] } for ] def
	/V [ 0 1 n 1 sub { /i exch def [ 0 1 n 1 sub { i eq { m_one }{ m_zero } ifelse } for ] } for ] def
	m_zero W { { m_abs 2 copy m_gt { pop }{ exch pop } ifelse } forall } forall /amax exch def
	/sym true def
	0 1 n 1 sub { /i exch def i 1 add 1 n 1 sub { /j exch def
		W i get j get W j get i get m_sub m_abs amax m_eps m_mul m_gt { /sym false def } if
	} for } for
	sym not { A end m_unguard end /meigsym errordict /rangecheck get exec } if
	/tol amax m_tol m_mul def
	/sweep 0 def
	{
		m_zero
		0 1 n 1 sub { /p exch def p 1 add 1 n 1 sub { /q exch def
			W p get q get m_abs 2 copy m_gt { pop }{ exch pop } ifelse
		} for } for
		tol m_gt not { exit } if
		/sweep sweep 1 add def sweep 60 gt { exit } if
		0 1 n 2 sub { /p exch def p 1 add 1 n 1 sub { /q exch def
			/apq W p get q get def
			apq m_isz not {
				/tau W q get q get W p get p get m_sub m_two apq m_mul m_div def
				/t tau m_isneg { m_one m_neg }{ m_one } ifelse
				   tau m_abs m_one tau tau m_mul m_add m_sqrt m_add m_div def
				/c m_one m_one t t m_mul m_add m_sqrt m_div def
				/s t c m_mul def
				0 1 n 1 sub { /k exch def                  % columns p and q
					[ W k get V k get ] { /rk exch def
						/akp rk p get def /akq rk q get def
						rk p c akp m_mul s akq m_mul m_sub put
						rk q s akp m_mul c akq m_mul m_add put
					} forall
				} for
				/rp W p get def /rq W q get def            % rows p and q
				0 1 n 1 sub { /k exch def
					/apk rp k get def /aqk rq k get def
					rp k c apk m_mul s aqk m_mul m_sub put
					rq k s apk m_mul c aqk m_mul m_add put
				} for
			} if
		} for } for
	} loop
	% sort ascending; make the largest component of each eigenvector positive
	/idx [ 0 1 n 1 sub { } for ] def
	1 1 n 1 sub { /k exch def
		/cur idx k get def /j k 1 sub def
		{ j 0 lt { exit } if
		  W idx j get get idx j get get  W cur get cur get  m_gt not { exit } if
		  idx j 1 add idx j get put /j j 1 sub def
		} loop
		idx j 1 add cur put
	} for
	/vals [ idx { dup W exch get exch get } forall ] def
	/vecs [ idx { /k exch def
		/big m_zero def /bs false def
		0 1 n 1 sub { V exch get k get dup m_abs big m_gt { dup m_abs /big exch def m_isneg /bs exch def }{ pop } ifelse } for
		[ 0 1 n 1 sub { V exch get k get bs { m_neg } if } for ]
	} forall ] def
	vals vecs
	end m_unguard
	m_finm exch [ exch { m_fin } forall ] exch
	end
} bind def

% ---------------------------------------------------------------- version 1.3

%A mtrace -> sum of the diagonal   (A square)
/mtrace {
	dup m_hasbn m_ops begin
	8 dict begin
	/A exch def
	A msize ne { A end end /mtrace errordict /rangecheck get exec } if
	m_zero 1 1 A length { dup A 3 1 roll mget m_cv m_add } for
	end m_fin end
} bind def

%A mnorm -> Frobenius norm, the square root of the sum of the squares
/mnorm {
	dup m_hasbn m_ops begin m_guard
	m_zero exch { { m_cv dup m_mul m_add } forall } forall m_sqrt
	m_unguard m_fin end
} bind def
%A mnorm1 -> largest sum of |elements| of a column
/mnorm1 {
	dup m_hasbn m_ops begin
	m_zero exch { m_zero exch { m_cv m_abs m_add } forall m_max } forall
	m_fin end
} bind def
%A mnorminf -> largest sum of |elements| of a row
/mnorminf { mtranspose mnorm1 } bind def

%A mcond -> condition number |A| |A^-1| in the norm mnorm1
% (undefinedresult if A is singular)
/mcond {
	dup minv mnorm1 exch mnorm1
	2 copy m_isbn exch m_isbn or { mulbn }{ mul } ifelse
} bind def

%A mrank -> rank of A   (Gaussian elimination with partial pivoting; an
% element counts as zero below m_eps times the largest |element| of A)
/mrank {
	dup m_hasbn m_ops begin m_guard
	20 dict begin
	/A exch def A msize /n exch def /m exch def
	/W [ 1 1 m { /i exch def [ 1 1 n { /j exch def A i j mget m_cv } for ] } for ] def
	m_zero W { { m_abs m_max } forall } forall m_eps m_mul /tol exch def
	/r 0 def
	0 1 n 1 sub { /c exch def
		r m lt {
			/p r def /best W r get c get m_abs def
			r 1 add 1 m 1 sub { /i exch def
				W i get c get m_abs dup best m_gt { /best exch def /p i def }{ pop } ifelse
			} for
			best tol m_gt {
				W p get W r get W exch p exch put W exch r exch put
				/rowr W r get def /piv rowr c get def
				r 1 add 1 m 1 sub { /i exch def /rowi W i get def
					/f rowi c get piv m_div def
					c 1 n 1 sub { /j exch def rowi j  rowi j get f rowr j get m_mul m_sub  put } for
				} for
				/r r 1 add def
			} if
		} if
	} for
	r
	end m_unguard end
} bind def

%A mlu -> L U P   with P A = L U   (A square; partial pivoting)
% L is lower triangular with ones on the diagonal, U upper triangular and P
% a permutation matrix. A singular A gives a zero on the diagonal of U.
/mlu {
	dup m_hasbn m_ops begin m_guard
	24 dict begin
	/A exch def
	A msize ne { A end m_unguard end /mlu errordict /rangecheck get exec } if
	/n A length def
	/W [ 1 1 n { /i exch def [ 1 1 n { /j exch def A i j mget m_cv } for ] } for ] def
	/Lw [ 1 1 n { pop [ 1 1 n { pop m_zero } for ] } for ] def
	/perm [ 0 1 n 1 sub { } for ] def
	0 1 n 1 sub { /c exch def
		/p c def /best W c get c get m_abs def
		c 1 add 1 n 1 sub { /i exch def
			W i get c get m_abs dup best m_gt { /best exch def /p i def }{ pop } ifelse
		} for
		p c ne {
			[ W Lw perm ] { /arr exch def arr p get arr c get arr exch p exch put arr exch c exch put } forall
		} if
		/rowc W c get def /piv rowc c get def
		piv m_isz not {
			c 1 add 1 n 1 sub { /i exch def /rowi W i get def
				/f rowi c get piv m_div def
				Lw i get c f put
				rowi c m_zero put
				c 1 add 1 n 1 sub { /j exch def rowi j  rowi j get f rowc j get m_mul m_sub  put } for
			} for
		} if
	} for
	0 1 n 1 sub { /i exch def Lw i get i m_one put } for
	Lw mfromrows W mfromrows
	/P n n marray def
	0 1 n 1 sub { /i exch def P i 1 add perm i get 1 add 1 mput } for
	P
	end m_unguard
	3 1 roll m_finm exch m_finm exch 3 -1 roll
	end
} bind def

% complex arithmetic on pairs re im (ops dict current)
/m_cmul { % ar ai br bi -> re im
	4 dict begin /m_bi exch def /m_br exch def /m_ai exch def /m_ar exch def
	m_ar m_br m_mul m_ai m_bi m_mul m_sub  m_ar m_bi m_mul m_ai m_br m_mul m_add
	end
} bind def
/m_cadd { exch 4 -1 roll m_add 3 1 roll m_add } bind def   % ar ai br bi -> re im
/m_cnorm { m_abs exch m_abs m_add } bind def      % re im -> |re| + |im|
/m_csqrt { % re im -> principal square root
	4 dict begin /m_ci exch def /m_cr exch def
	m_cr m_isz m_ci m_isz and { m_zero m_zero }{
		/m_ca m_cr m_cr m_mul m_ci m_ci m_mul m_add m_sqrt def
		m_cr m_isneg {
			/m_ct m_ca m_cr m_sub m_two m_div m_sqrt def
			m_ci m_abs m_two m_ct m_mul m_div
			m_ci m_isneg { m_ct m_neg }{ m_ct } ifelse
		}{
			/m_ct m_ca m_cr m_add m_two m_div m_sqrt def
			m_ct  m_ci m_two m_ct m_mul m_div
		} ifelse
	} ifelse
	end
} bind def

%A meig -> [ [re im] ... ]   every eigenvalue of a square matrix, as complex
% numbers sorted by real part. Reduction to Hessenberg form, then QR steps
% in complex arithmetic with Wilkinson shifts.
/meig {
	dup m_hasbn m_ops begin m_guard
	50 dict begin
	/A exch def A msize /n exch def /m exch def
	m n ne { A end m_unguard end /meig errordict /rangecheck get exec } if
	/Hr [ 1 1 n { /i exch def [ 1 1 n { /j exch def A i j mget m_cv } for ] } for ] def
	% Hessenberg form by stabilised elementary similarity transformations
	1 1 n 2 sub { /k exch def /c k 1 sub def
		/p k def /best Hr k get c get m_abs def
		k 1 add 1 n 1 sub { /i exch def
			Hr i get c get m_abs dup best m_gt { /best exch def /p i def }{ pop } ifelse
		} for
		p k ne {
			Hr p get Hr k get Hr exch p exch put Hr exch k exch put
			Hr { /row exch def row p get row k get row exch p exch put row exch k exch put } forall
		} if
		/piv Hr k get c get def
		piv m_isz not {
			k 1 add 1 n 1 sub { /i exch def
				/f Hr i get c get piv m_div def
				f m_isz not {
					c 1 n 1 sub { /j exch def Hr i get j  Hr i get j get f Hr k get j get m_mul m_sub  put } for
					Hr i get c m_zero put
					0 1 n 1 sub { /j exch def Hr j get k  Hr j get k get f Hr j get i get m_mul m_add  put } for
				} if
			} for
		} if
	} for
	/Hi [ 1 1 n { pop [ 1 1 n { pop m_zero } for ] } for ] def
	m_zero Hr { { m_abs m_max } forall } forall /anorm exch def
	anorm m_isz { /anorm m_one def } if
	/tol m_tol def
	/er n array def /ei n array def
	/hi n 1 sub def /iter 0 def /total 0 def
	/hget { 2 copy Hr 3 -1 roll get exch get 3 1 roll Hi 3 -1 roll get exch get } bind def   % i j -> re im
	/hput { 3 index Hi exch get 3 index 3 -1 roll put Hr 3 index get 3 1 roll put pop } bind def % i j re im ->
	{
		hi 0 lt { exit } if
		/l hi def
		{ l 0 le { exit } if
		  /s l 1 sub l 1 sub hget m_cnorm l l hget m_cnorm m_add def
		  s m_isz { /s anorm def } if
		  l l 1 sub hget m_cnorm s tol m_mul m_gt not { l l 1 sub m_zero m_zero hput exit } if
		  /l l 1 sub def
		} loop
		l hi eq total 30 n mul gt or {
			hi hi hget ei hi 3 -1 roll put er hi 3 -1 roll put
			/hi hi 1 sub def /iter 0 def
		}{
			/iter iter 1 add def /total total 1 add def
			% shift: the eigenvalue of the trailing 2x2 block closer to its last element
			hi 1 sub hi 1 sub hget /ai exch def /ar exch def
			hi 1 sub hi hget /bi exch def /br exch def
			hi hi 1 sub hget /ci exch def /cr exch def
			hi hi hget /di exch def /dr exch def
			iter 10 mod 0 eq {
				/mur dr cr m_abs m_add def /mui di def            % exceptional shift
			}{
				/hr_ ar dr m_sub m_two m_div def /hi_ ai di m_sub m_two m_div def
				hr_ hi_ hr_ hi_ m_cmul br bi cr ci m_cmul m_cadd
				m_csqrt /qi exch def /qr exch def
				/sr ar dr m_add m_two m_div def /si ai di m_add m_two m_div def
				% of sr + q and sr - q, take the one nearer d
				sr qr m_add dr m_sub si qi m_add di m_sub m_cnorm
				sr qr m_sub dr m_sub si qi m_sub di m_sub m_cnorm
				m_gt { /mur sr qr m_sub def /mui si qi m_sub def }{ /mur sr qr m_add def /mui si qi m_add def } ifelse
			} ifelse
			l 1 hi { /k exch def k k hget mui m_sub exch mur m_sub exch k k 4 2 roll hput } for
			/gc hi array def /gs hi array def
			l 1 hi 1 sub { /k exch def
				k k hget /xi exch def /xr exch def
				k 1 add k hget /yi exch def /yr exch def
				/rr xr dup m_mul xi dup m_mul m_add yr dup m_mul m_add yi dup m_mul m_add m_sqrt def
				rr m_isz { /cr_ m_one def /ci_ m_zero def /sr_ m_zero def /si_ m_zero def }{
					/cr_ xr rr m_div def /ci_ xi rr m_div def /sr_ yr rr m_div def /si_ yi rr m_div def
				} ifelse
				gc k [ cr_ ci_ ] put gs k [ sr_ si_ ] put
				k 1 hi { /j exch def
					k j hget /ui exch def /ur exch def
					k 1 add j hget /vi exch def /vr exch def
					k j  cr_ ci_ m_neg ur ui m_cmul  sr_ si_ m_neg vr vi m_cmul  m_cadd  hput
					k 1 add j  sr_ m_neg si_ m_neg ur ui m_cmul  cr_ ci_ vr vi m_cmul  m_cadd  hput
				} for
			} for
			l 1 hi 1 sub { /k exch def
				gc k get aload pop /ci_ exch def /cr_ exch def
				gs k get aload pop /si_ exch def /sr_ exch def
				l 1 k 1 add hi 2 copy gt { exch } if pop { /j exch def
					j k hget /ui exch def /ur exch def
					j k 1 add hget /vi exch def /vr exch def
					j k  ur ui cr_ ci_ m_cmul  vr vi sr_ si_ m_cmul  m_cadd  hput
					j k 1 add  ur ui sr_ m_neg si_ m_cmul  vr vi cr_ ci_ m_neg m_cmul  m_cadd  hput
				} for
			} for
			l 1 hi { /k exch def k k hget mui m_add exch mur m_add exch k k 4 2 roll hput } for
		} ifelse
	} loop
	% parts below the working accuracy become exactly 0
	/lim anorm tol m_mul m_one type /integertype eq { 10 }{ 1000 } ifelse m_cv m_mul def
	0 1 n 1 sub { /k exch def
		ei k get m_abs lim m_gt not { ei k m_zero put } if
		er k get m_abs lim m_gt not { er k m_zero put } if
	} for
	% sort by real part, then imaginary part
	/idx [ 0 1 n 1 sub { } for ] def
	1 1 n 1 sub { /k exch def
		/cur idx k get def /j k 1 sub def
		{ j 0 lt { exit } if
		  /o idx j get def
		  /dre er o get er cur get m_sub def
		  dre m_abs lim m_gt not { ei o get ei cur get m_gt }{ dre m_isneg not } ifelse
		  not { exit } if
		  idx j 1 add o put /j j 1 sub def
		} loop
		idx j 1 add cur put
	} for
	[ idx { /k exch def [ er k get ei k get ] } forall ]
	end m_unguard
	[ exch { aload pop m_fin exch m_fin exch 2 array astore } forall ]
	end
} bind def

% ---------------------------------------------------------------- version 1.4

% helpers on lists of elements (ops dict current, no rounding)
/m_dotv { % u v -> u . v
	m_zero 0 1 3 index length 1 sub { 3 index 1 index get 3 index 2 index get m_mul exch pop m_add } for
	3 1 roll pop pop
} bind def
/m_mm { % X Y -> X Y   (matrices as lists of columns, converted elements)
	6 dict begin /m_my exch def /m_mx exch def
	[ m_my { /m_yc exch def
		[ 0 1 m_mx 0 get length 1 sub { /m_ri exch def
			m_zero 0 1 m_yc length 1 sub { /m_kk exch def m_mx m_kk get m_ri get m_yc m_kk get m_mul m_add } for
		} for ]
	} forall ]
	end
} bind def
/m_colsof { [ exch { [ exch { m_cv } forall ] } forall ] } bind def   % M -> converted copy

%A B mkron -> Kronecker product A (x) B: block (i, j) is a_ij B
/mkron {
	2 copy m_hasbn exch m_hasbn or m_ops begin
	16 dict begin
	/B exch def /A exch def
	A msize /na exch def /ma exch def
	B msize /nb exch def /mb exch def
	/C ma mb mul na nb mul marray def
	1 1 ma { /ia exch def 1 1 na { /ja exch def
		/aij A ia ja mget m_cv def
		1 1 mb { /ib exch def 1 1 nb { /jb exch def
			C ia 1 sub mb mul ib add ja 1 sub nb mul jb add
			aij B ib jb mget m_cv m_mul mput
		} for } for
	} for } for
	C m_finm
	end end
} bind def

%[d1 d2 ...] mdiag -> diagonal matrix     M mdiag -> [m11 m22 ...]
/mdiag {
	dup type /arraytype ne { /mdiag errordict /typecheck get exec } if
	dup length 0 eq { /mdiag errordict /rangecheck get exec } if
	dup 0 get dup type /arraytype eq exch m_isbn not and {
		8 dict begin /A exch def A msize 2 copy gt { exch } if pop /k exch def
		[ 1 1 k { dup A 3 1 roll mget } for ]
		end
	}{
		8 dict begin /L exch def /n L length def
		/D n n marray def
		1 1 n { /i exch def D i i L i 1 sub get mput } for
		D end
	} ifelse
} bind def

%A k mpow -> A^k   (A square, k an integer; k < 0 uses the inverse,
% k = 0 gives the identity; undefinedresult for k < 0 and a singular A)
/mpow {
	dup type /integertype ne { /mpow errordict /typecheck get exec } if
	1 index msize ne { /mpow errordict /rangecheck get exec } if
	12 dict begin
	/k exch def /A exch def
	k 0 lt {
		A mdet dup m_isbn { bniszero }{ 0 eq } ifelse
		{ A k end /mpow errordict /undefinedresult get exec } if
		/A A minv def /k k neg def
	} if
	/R A length midentity def /P A def
	{ k 0 eq { exit } if
	  k 2 mod 1 eq { /R R P mmul def } if
	  /k k 2 idiv def
	  k 0 gt { /P P P mmul def } if
	} loop
	R
	end
} bind def

%A mchol -> L   with A = L L^T, L lower triangular with a positive diagonal
% (Cholesky). rangecheck if A is not square, symmetric and positive definite.
/mchol {
	dup m_hasbn m_ops begin m_guard
	24 dict begin
	/A exch def A msize /n exch def /m exch def
	m n ne { A end m_unguard end /mchol errordict /rangecheck get exec } if
	/W [ 1 1 n { /i exch def [ 1 1 n { /j exch def A i j mget m_cv } for ] } for ] def
	m_zero W { { m_abs m_max } forall } forall /amax exch def
	/ok true def
	0 1 n 1 sub { /i exch def i 1 add 1 n 1 sub { /j exch def
		W i get j get W j get i get m_sub m_abs amax m_eps m_mul m_gt { /ok false def } if
	} for } for
	/L [ 1 1 n { pop [ 1 1 n { pop m_zero } for ] } for ] def
	ok { 0 1 n 1 sub { /j exch def
		W j get j get 0 1 j 1 sub { L j get exch get dup m_mul m_sub } for
		/s exch def
		s amax m_eps m_mul m_gt not { /ok false def exit } if
		/d s m_sqrt def L j get j d put
		j 1 add 1 n 1 sub { /i exch def
			W i get j get 0 1 j 1 sub { /k exch def L i get k get L j get k get m_mul m_sub } for
			d m_div L i get j 3 -1 roll put
		} for
	} for } if
	ok not { A end m_unguard end /mchol errordict /rangecheck get exec } if
	[ 0 1 n 1 sub { /j exch def [ 0 1 n 1 sub { L exch get j get } for ] } for ]
	end m_unguard m_finm end
} bind def

%A mqr -> Q R   with A = Q R   (A m x n with m >= n, else rangecheck)
% Q is m x n with orthonormal columns, R n x n upper triangular with a
% positive diagonal (Gram-Schmidt, each column orthogonalised twice).
% undefinedresult if the columns of A are linearly dependent.
/mqr {
	dup m_hasbn m_ops begin m_guard
	24 dict begin
	/A exch def A msize /n exch def /m exch def
	m n lt { A end m_unguard end /mqr errordict /rangecheck get exec } if
	/Q A m_colsof def
	m_zero Q { { m_abs m_max } forall } forall m_eps m_mul /tol exch def
	/Rr [ 1 1 n { pop [ 1 1 n { pop m_zero } for ] } for ] def
	/ok true def
	0 1 n 1 sub { /j exch def /v Q j get def
		2 { 0 1 j 1 sub { /i exch def /qi Q i get def
			qi v m_dotv /r exch def
			Rr i get j  Rr i get j get r m_add  put
			0 1 m 1 sub { /k exch def v k  v k get r qi k get m_mul m_sub  put } for
		} for } repeat
		v v m_dotv m_sqrt /nrm exch def
		nrm tol m_gt not { /ok false def exit } if
		Rr j get j nrm put
		0 1 m 1 sub { /k exch def v k  v k get nrm m_div  put } for
	} for
	ok not { A end m_unguard end /mqr errordict /undefinedresult get exec } if
	Q
	[ 0 1 n 1 sub { /j exch def [ 0 1 n 1 sub { Rr exch get j get } for ] } for ]
	end m_unguard
	m_finm exch m_finm exch
	end
} bind def

% A -> U S V, thin singular value decomposition without rounding (ops dict
% and guard digits current): one-sided Jacobi rotations on the columns
/m_svd {
	40 dict begin
	/A exch def A msize /n exch def /m exch def
	m n lt {
		A mtranspose m_svd /V2 exch def /S2 exch def /U2 exch def
		V2 S2 U2
	}{
		/W A m_colsof def
		/V [ 0 1 n 1 sub { /i exch def [ 0 1 n 1 sub { i eq { m_one }{ m_zero } ifelse } for ] } for ] def
		/tol m_tol def
		% columns with a square norm below zfl count as zero
		m_zero W { { dup m_mul m_add } forall } forall m_eps m_mul m_eps m_mul /zfl exch def
		/rotc { % xp xq ->   (xp, xq) <- (c xp - s xq, s xp + c xq)
			/xq exch def /xp exch def
			0 1 xp length 1 sub { /k exch def /a1 xp k get def /b1 xq k get def
				xp k c a1 m_mul s b1 m_mul m_sub put
				xq k s a1 m_mul c b1 m_mul m_add put
			} for
		} def
		/sweep 0 def
		{ /rot false def
		  0 1 n 2 sub { /p exch def p 1 add 1 n 1 sub { /q exch def
			/wp W p get def /wq W q get def
			/ga wp wq m_dotv def
			ga m_isz not {
				/al wp wp m_dotv def /be wq wq m_dotv def
				al zfl m_gt be zfl m_gt and { ga m_abs al be m_mul m_sqrt tol m_mul m_gt }{ false } ifelse {
					/rot true def
					/ze be al m_sub m_two ga m_mul m_div def
					% t = sign(ze) / (|ze| + sqrt(1 + ze^2)), without overflow
					/za ze m_abs def
					za m_one m_gt {
						m_one za m_div /zi exch def
						m_one za m_one m_one zi zi m_mul m_add m_sqrt m_add m_mul m_div
					}{ m_one za m_one za za m_mul m_add m_sqrt m_add m_div } ifelse
					ze m_isneg { m_neg } if /t exch def
					/c m_one m_one t t m_mul m_add m_sqrt m_div def
					/s c t m_mul def
					wp wq rotc  V p get V q get rotc
				} if
			} if
		  } for } for
		  rot not { exit } if
		  /sweep sweep 1 add def sweep 60 gt { exit } if
		} loop
		/sig [ W { dup m_dotv m_sqrt } forall ] def
		/idx [ 0 1 n 1 sub { } for ] def
		1 1 n 1 sub { /k exch def
			/cur idx k get def /j k 1 sub def
			{ j 0 lt { exit } if
			  sig idx j get get sig cur get m_lt not { exit } if
			  idx j 1 add idx j get put /j j 1 sub def
			} loop
			idx j 1 add cur put
		} for
		/ztol sig idx 0 get get m_eps m_mul def
		/Ul [ ] def
		/S [ idx { /k exch def
			sig k get ztol m_gt {
				/u [ W k get { sig k get m_div } forall ] def
				/Ul [ Ul aload pop u ] def sig k get
			}{
				% complete U with a unit vector orthogonal to the columns so far
				0 1 m 1 sub { /r exch def
					/u [ 0 1 m 1 sub { r eq { m_one }{ m_zero } ifelse } for ] def
					2 { Ul { /w exch def w u m_dotv /dd exch def
						0 1 m 1 sub { /i exch def u i  u i get dd w i get m_mul m_sub  put } for
					} forall } repeat
					u u m_dotv m_sqrt /nu exch def
					nu m_two m_mul m_one m_gt { exit } if
				} for
				/u [ u { nu m_div } forall ] def
				/Ul [ Ul aload pop u ] def m_zero
			} ifelse
		} forall ] def
		Ul S [ idx { V exch get } forall ]
	} ifelse
	end
} bind def

%A msvd -> U S V   with A = U diag(S) V^T   (thin singular value
% decomposition, A m x n, k = min(m, n)): U m x k and V n x k with
% orthonormal columns, S the list of the k singular values, largest first.
% One-sided Jacobi rotations; singular values below the zero tolerance
% (largest times m_eps) are given as 0.
/msvd {
	dup m_hasbn m_ops begin m_guard m_svd m_unguard
	m_finm 3 1 roll [ exch { m_fin } forall ] exch m_finm exch 3 -1 roll
	end
} bind def

%A msingular -> [s1 s2 ...]   the singular values, largest first
/msingular { msvd pop exch pop } bind def

%A mpinv -> pseudo-inverse A+ (n x m for A m x n), V diag(1/s) U^T over
% the singular values above the zero tolerance (largest times m_eps)
/mpinv {
	dup m_hasbn m_ops begin m_guard
	20 dict begin
	/A exch def A msize /n exch def /m exch def
	A m_svd /V exch def /S exch def /U exch def
	/k S length def
	S 0 get m_eps m_mul /ztol exch def
	[ 0 1 m 1 sub { /jj exch def [ 0 1 n 1 sub { /ii exch def
		m_zero 0 1 k 1 sub { /kk exch def
			S kk get ztol m_gt { V kk get ii get U kk get jj get m_mul S kk get m_div m_add } if
		} for
	} for ] } for ]
	end m_unguard m_finm end
} bind def

%A mnull -> N   whose columns are an orthonormal basis of the null space
% of A (the x with A x = 0), from the SVD; the empty list [] if only x = 0
/mnull {
	dup m_hasbn m_ops begin m_guard
	20 dict begin
	/A exch def A msize /n exch def /m exch def
	m n lt { /A [ A { [ exch aload pop n m sub { 0 } repeat ] } forall ] def } if
	A m_svd /V exch def /S exch def pop
	S 0 get m_eps m_mul /ztol exch def
	[ 0 1 n 1 sub { /kk exch def S kk get ztol m_gt not { V kk get } if } for ]
	end m_unguard m_finm end
} bind def

%A meigsymv -> [values] V   the same as meigsym: eigenvalues ascending and
% the unit eigenvectors as the columns of V
/meigsymv { meigsym } bind def

%A meigvec -> [ [z v] ... ]   every eigenvalue z of a square matrix, as meig
% gives them, with an eigenvector v, a list of complex numbers [re im] of
% unit length whose largest component is real and positive. Inverse
% iteration in complex arithmetic. For a repeated eigenvalue the vectors
% are made orthogonal when there are that many independent ones; otherwise
% (a defective matrix) the same vector is repeated.
/meigvec {
	dup meig exch
	dup m_hasbn m_ops begin m_guard
	64 dict begin
	/A exch def /Z exch def
	A msize /n exch def pop
	/Ar [ 1 1 n { /i exch def [ 1 1 n { /j exch def A i j mget m_cv } for ] } for ] def
	m_zero Ar { { m_abs m_max } forall } forall /anorm exch def
	anorm m_isz { /anorm m_one def } if
	/tiny anorm m_eps m_mul def
	/samtol anorm m_eps m_mul 1000 m_cv m_mul def
	/restol anorm m_eps m_mul 100 m_cv m_mul def
	/cdv { % ar ai br bi -> (a / b) re im
		/d_bi exch def /d_br exch def /d_ai exch def /d_ar exch def
		/d_den d_br d_br m_mul d_bi d_bi m_mul m_add def
		d_ar d_br m_mul d_ai d_bi m_mul m_add d_den m_div
		d_ai d_br m_mul d_ar d_bi m_mul m_sub d_den m_div
	} def
	/csolve { % br bi -> xr xi   with (A - lambda I) x = b, tiny pivots replaced
		/bi_ exch def /br_ exch def
		/Wr [ 0 1 n 1 sub { /ii exch def [ 0 1 n 1 sub { /jj exch def Ar ii get jj get ii jj eq { lr m_sub } if } for br_ ii get ] } for ] def
		/Wi [ 0 1 n 1 sub { /ii exch def [ 0 1 n 1 sub { /jj exch def ii jj eq { li m_neg }{ m_zero } ifelse } for bi_ ii get ] } for ] def
		0 1 n 1 sub { /c exch def
			/p c def /best Wr c get c get Wi c get c get m_cnorm def
			c 1 add 1 n 1 sub { /r exch def
				Wr r get c get Wi r get c get m_cnorm dup best m_gt { /best exch def /p r def }{ pop } ifelse
			} for
			p c ne { [ Wr Wi ] { /arr exch def arr p get arr c get arr exch p exch put arr exch c exch put } forall } if
			best tiny m_gt not { Wr c get c tiny put Wi c get c m_zero put } if
			/pvr Wr c get c get def /pvi Wi c get c get def
			c 1 add 1 n 1 sub { /r exch def
				Wr r get c get Wi r get c get pvr pvi cdv /fi exch def /fr exch def
				c 1 n { /j exch def
					fr fi Wr c get j get Wi c get j get m_cmul /ti exch def /tr exch def
					Wr r get j  Wr r get j get tr m_sub  put
					Wi r get j  Wi r get j get ti m_sub  put
				} for
			} for
		} for
		/xr n array def /xi n array def
		n 1 sub -1 0 { /ii exch def
			Wr ii get n get Wi ii get n get
			ii 1 add 1 n 1 sub { /j exch def
				Wr ii get j get Wi ii get j get xr j get xi j get m_cmul
				3 -1 roll exch m_sub 3 1 roll m_sub exch
			} for
			Wr ii get ii get Wi ii get ii get cdv xi ii 3 -1 roll put xr ii 3 -1 roll put
		} for
		xr xi
	} def
	/vnorm { % vr vi -> vr vi with unit length
		/ni_ exch def /nr_ exch def
		m_zero 0 1 n 1 sub { /ii exch def nr_ ii get dup m_mul ni_ ii get dup m_mul m_add m_add } for
		m_sqrt /nn exch def
		nn m_isz { nr_ ni_ }{ [ nr_ { nn m_div } forall ] [ ni_ { nn m_div } forall ] } ifelse
	} def
	/vorth { % vr vi -> vr vi minus its projections on the vectors in same
		/oi_ exch def /or_ exch def
		same { aload pop /ui_ exch def /ur_ exch def
			m_zero m_zero 0 1 n 1 sub { /ii exch def ur_ ii get ui_ ii get m_neg or_ ii get oi_ ii get m_cmul m_cadd } for
			/di_ exch def /dr_ exch def
			0 1 n 1 sub { /ii exch def
				dr_ di_ ur_ ii get ui_ ii get m_cmul /ti exch def /tr exch def
				or_ ii or_ ii get tr m_sub put  oi_ ii oi_ ii get ti m_sub put
			} for
		} forall
		or_ oi_
	} def
	/invit { % vr vi doorth -> vr vi
		/dorth exch def
		dorth { vorth } if vnorm
		3 { csolve dorth { vorth } if vnorm } repeat
	} def
	/resid { % vr vi -> largest |(A v - lambda v)_i|
		/si_ exch def /sr_ exch def
		m_zero 0 1 n 1 sub { /ii exch def
			m_zero m_zero 0 1 n 1 sub { /jj exch def Ar ii get jj get m_zero sr_ jj get si_ jj get m_cmul m_cadd } for
			lr li sr_ ii get si_ ii get m_cmul m_neg exch m_neg exch m_cadd m_cnorm m_max
		} for
	} def
	/vecs n array def
	0 1 n 1 sub { /e exch def
		/lr Z e get 0 get m_cv def /li Z e get 1 get m_cv def
		/same [ 0 1 e 1 sub { /f exch def
			Z f get 0 get m_cv lr m_sub Z f get 1 get m_cv li m_sub m_cnorm samtol m_gt not { vecs f get } if
		} for ] def
		/b0 [ 0 1 n 1 sub { pop m_zero } for ] def
		[ 0 1 n 1 sub { 1 add m_cv m_sqrt m_one exch m_div } for ] [ b0 aload pop ] false invit
		/vi exch def /vr exch def
		same length 0 gt {
			[ 0 1 n 1 sub { dup 2 add m_cv m_sqrt m_one exch m_div exch 2 mod 1 eq { m_neg } if } for ]
			[ b0 aload pop ] true invit /wi exch def /wr exch def
			wr wi resid restol m_gt not { /vr wr def /vi wi def } if
		} if
		% largest component real and positive; tiny parts become 0
		% (the first of components equal to within rounding)
		/bk 0 def /bm m_zero def
		0 1 n 1 sub { /ii exch def
			vr ii get dup m_mul vi ii get dup m_mul m_add
			dup bm m_one m_eps 100 m_cv m_mul m_add m_mul m_gt { /bm exch def /bk ii def }{ pop } ifelse
		} for
		/bm vr bk get dup m_mul vi bk get dup m_mul m_add def
		/am bm m_sqrt def /pr vr bk get am m_div def /pq vi bk get m_neg am m_div def
		/ur n array def /ui n array def
		0 1 n 1 sub { /ii exch def
			vr ii get vi ii get pr pq m_cmul
			dup m_abs m_eps m_gt not { pop m_zero } if ui ii 3 -1 roll put
			dup m_abs m_eps m_gt not { pop m_zero } if ur ii 3 -1 roll put
		} for
		ui bk m_zero put
		vecs e [ ur ui ] put
	} for
	[ 0 1 n 1 sub { /e exch def
		[ Z e get [ 0 1 n 1 sub { /ii exch def [ vecs e get aload pop ii get exch ii get exch ] } for ] ]
	} for ]
	end m_unguard
	[ exch { aload pop [ exch { aload pop m_fin exch m_fin exch 2 array astore } forall ] 2 array astore } forall ]
	end
} bind def

%A mexp -> e^A   (A square): scaling and squaring of the Taylor series
/mexp {
	dup m_hasbn m_ops begin m_guard m_guard
	24 dict begin
	/A exch def A msize /n exch def /m exch def
	m n ne { A end m_unguard m_unguard end /mexp errordict /rangecheck get exec } if
	/B A m_colsof def
	/nrm m_zero B { m_zero exch { m_abs m_add } forall m_max } forall def
	/sq 0 def /half m_one m_two m_div def
	{ nrm half m_gt not { exit } if /nrm nrm m_two m_div def /sq sq 1 add def } loop
	sq 0 gt {
		/f m_one def sq { /f f m_two m_mul def } repeat
		/B [ B { [ exch { f m_div } forall ] } forall ] def
	} if
	/E [ 0 1 n 1 sub { /i exch def [ 0 1 n 1 sub { i eq { m_one }{ m_zero } ifelse } for ] } for ] def
	/T [ E { [ exch aload pop ] } forall ] def
	/tol m_eps 1000 m_cv m_div def
	1 1 300 { /kk exch def /kc kk m_cv def
		/T [ T B m_mm { [ exch { kc m_div } forall ] } forall ] def
		/E [ 0 1 n 1 sub { /jj exch def [ 0 1 n 1 sub { /ii exch def E jj get ii get T jj get ii get m_add } for ] } for ] def
		m_zero T { { m_abs m_max } forall } forall tol m_gt not { exit } if
	} for
	sq { /E E E m_mm def } repeat
	E
	end m_unguard m_unguard m_finm end
} bind def

%M mPrint -> prints M one row per line
/mPrint {
	dup m_hasbn m_ops begin
	mtorows {
		dup 0 get m_cv m_str print
		1 1 index length 1 sub getinterval { ( ) print m_cv m_str print } forall
		() =
	} forall
	end
} bind def

