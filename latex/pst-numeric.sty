\RequirePackage{pstricks}
\RequirePackage{pst-plot}
\ProvidesPackage{pst-numeric}[2026/11/22 v1.4 package wrapper for
  pst-numeric.tex (BL)]
% Options choose the parts to load (the default is all of them):
% bignum, trig, matrix, complex, calc, special, tensor, all
\def\pstnum@opts{}
\def\pstnum@opt#1{\DeclareOption{#1}{\edef\pstnum@opts{\pstnum@opts#1,}}}
\pstnum@opt{bignum}
\pstnum@opt{trig}
\pstnum@opt{matrix}
\pstnum@opt{complex}
\pstnum@opt{calc}
\pstnum@opt{special}
\pstnum@opt{tensor}
\DeclareOption{all}{\edef\pstnum@opts{\pstnum@opts bignum,trig,matrix,complex,calc,special,tensor,}}
\DeclareOption*{\PackageError{pst-numeric}{Unknown option `\CurrentOption'}%
  {The options are bignum, trig, matrix, complex, calc, special, tensor and all.}}
\ProcessOptions\relax
\ifx\pstnum@opts\@empty\else\let\pstNumericParts\pstnum@opts\fi
\input{pst-numeric.tex}
\ProvidesFile{pst-numeric.tex}
  [\filedate\space v\fileversion\space `PST-numeric' (BL)]
\endinput
