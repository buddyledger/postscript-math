% Every name is defined in tx@PostScriptMathDict, so that nothing clashes with other
% PostScript code. Load.ps leaves the dictionary open; after loading a file
% on its own, use  tx@PostScriptMathDict begin ... end  around calls.
/tx@PostScriptMathDict where { pop }{ /tx@PostScriptMathDict 600 dict def } ifelse
tx@PostScriptMathDict begin
% Everything here works on ordinary numbers, or on bignums when any input
% is a bignum or a string such as (0.1) (see Matrix.ps). Needs Matrix.ps;
% polyval with a complex x and polyroots need Complex.ps.
%
% A function argument {f} takes x and returns f(x). In bignum mode it
% receives bignums and must return a bignum or a number. It runs at 6
% digits above bnn, so it should not change bnn. Names starting with n_
% are internal.

% ---------------------------------------------------------------- integers

/gcd { % a b (integers) -> greatest common divisor, >= 0
	abs exch abs { dup 0 eq { pop exit } if dup 3 1 roll mod } loop
} bind def
/lcm { % a b (integers) -> least common multiple, >= 0
	2 copy gcd dup 0 eq { pop pop pop 0 }{ 3 1 roll mul abs exch idiv } ifelse
} bind def

% ---------------------------------------------------------------- helpers

/n_cat { % (a) (b) -> (ab)
	1 index length 1 index length add string
	dup 0 4 index putinterval
	dup 3 index length 3 index putinterval
	3 1 roll pop pop
} bind def
/n_hasbn { false exch { m_isstrbn or } forall } bind def   % array -> bool
/n_max { 2 copy m_gt { pop }{ exch pop } ifelse } bind def % a b -> larger (ops dict current)

% ---------------------------------------------------------------- root finding

%{f} a b froot -> x with f(x) = 0, for f(a) and f(b) of opposite sign.
% Illinois method (regula falsi that halves the stale end's value), which
% keeps the root bracketed and converges superlinearly.
/froot {
	2 copy m_isstrbn exch m_isstrbn or m_ops begin m_guard
	20 dict begin
	/n_b exch m_cv def /n_a exch m_cv def /n_f exch def
	/n_fa n_a n_f m_cv def /n_fb n_b n_f m_cv def
	n_fa m_isz { n_a }{ n_fb m_isz { n_b }{
		n_fa m_isneg n_fb m_isneg eq {
			/n_f load n_a n_b end m_unguard end /froot errordict /rangecheck get exec
		} if
		/n_w n_b n_a m_sub m_abs m_tol m_mul def        % smallest scale, for a root at 0
		/n_side 0 def /n_c n_a def /n_it 0 def
		{
			/n_cold n_c def
			/n_c n_a n_fb m_mul n_b n_fa m_mul m_sub n_fb n_fa m_sub m_div def
			/n_fc n_c n_f m_cv def
			/n_it n_it 1 add def
			n_fc m_isz { exit } if
			n_it 1 gt { n_c n_cold m_sub m_isz { exit } if } if
			n_fc m_isneg n_fb m_isneg eq {
				/n_b n_c def /n_fb n_fc def
				n_side -1 eq { /n_fa n_fa m_two m_div def } if /n_side -1 def
			}{
				/n_a n_c def /n_fa n_fc def
				n_side 1 eq { /n_fb n_fb m_two m_div def } if /n_side 1 def
			} ifelse
			n_b n_a m_sub m_abs  n_c m_abs n_w n_max m_tol m_mul  m_gt not { exit } if
			n_it 500 gt { exit } if
		} loop
		n_c
	} ifelse } ifelse
	end m_unguard m_fin end
} bind def

% ---------------------------------------------------------------- integration

/n_nodecache 20 dict def
/n_lp { % -> P_n(z) P_n'(z)   (Legendre recurrence; uses n_z, n_n)
	/n_p0 m_one def /n_p1 n_z def
	2 1 n_n { /n_k exch def
		/n_p2  2 n_k mul 1 sub m_cv n_z m_mul n_p1 m_mul  n_k 1 sub m_cv n_p0 m_mul m_sub  n_k m_cv m_div def
		/n_p0 n_p1 def /n_p1 n_p2 def
	} for
	n_p1  n_n m_cv  n_z n_p1 m_mul n_p0 m_sub m_mul  n_z n_z m_mul m_one m_sub m_div
} bind def
/n_nodes { % n (even) -> [x] [w]   positive Gauss-Legendre nodes and weights, cached
12 dict begin
	/n_n exch def
	m_one type /integertype eq { (r) }{ (b) } ifelse
	n_n 10 string cvs n_cat (_) n_cat bnn 10 string cvs n_cat cvn /n_key exch def
	n_nodecache n_key known { n_nodecache n_key get aload pop }{
		/n_xs n_n 2 idiv array def /n_ws n_n 2 idiv array def
		1 1 n_n 2 idiv { /n_i exch def
			/n_z 180 n_i 0.25 sub mul n_n 0.5 add div cos m_cv def    % first guess
			/n_it 0 def
			{ n_lp /n_dp exch def /n_pv exch def
			  /n_dz n_pv n_dp m_div def
			  /n_z n_z n_dz m_sub def
			  /n_it n_it 1 add def
			  n_dz m_abs n_z m_abs m_tol m_mul m_gt not n_it 40 gt or { exit } if
			} loop
			n_lp /n_dp exch def pop
			n_xs n_i 1 sub n_z put
			n_ws n_i 1 sub  m_two  m_one n_z n_z m_mul m_sub n_dp n_dp m_mul m_mul  m_div put
		} for
		n_nodecache n_key [ n_xs n_ws ] put
		n_xs n_ws
	} ifelse
end
} bind def
/n_gl { % a b n -> n-point Gauss-Legendre value on [a, b]
12 dict begin
	/n_n exch def /n_q exch def /n_p exch def
	n_n n_nodes /n_ws exch def /n_xs exch def
	/n_h n_q n_p m_sub m_two m_div def /n_m n_q n_p m_add m_two m_div def
	m_zero
	0 1 n_xs length 1 sub { /n_i exch def
		/n_t n_xs n_i get n_h m_mul def
		n_m n_t m_add n_if m_cv  n_m n_t m_sub n_if m_cv  m_add
		n_ws n_i get m_mul m_add
	} for
	n_h m_mul
end
} bind def
/n_irec { % a b depth -> integral, halving the interval until 16 and 32 points agree
12 dict begin
	/n_d exch def /n_bb exch def /n_aa exch def
	/n_g1 n_aa n_bb 16 n_gl def /n_g2 n_aa n_bb 32 n_gl def
	n_g2 n_g1 m_sub m_abs n_itol m_gt not n_d n_imaxd ge or { n_g2 }{
		/n_mid n_aa n_bb m_add m_two m_div def
		n_aa n_mid n_d 1 add n_irec  n_mid n_bb n_d 1 add n_irec  m_add
	} ifelse
end
} bind def

%{f} a b fintegrate -> integral of f from a to b
% Gauss-Legendre with 16 and 32 points; where they disagree the interval is
% halved (up to 12 times for reals, 30 for bignums).
/fintegrate {
	2 copy m_isstrbn exch m_isstrbn or m_ops begin m_guard
	12 dict begin
	/n_ib exch m_cv def /n_ia exch m_cv def /n_if exch def
	/n_imaxd m_one type /integertype eq { 12 }{ 30 } ifelse def
	/n_g1 n_ia n_ib 16 n_gl def /n_g2 n_ia n_ib 32 n_gl def
	/n_itol n_g2 m_abs m_tol m_mul def
	n_itol m_isz { /n_itol n_ib n_ia m_sub m_abs m_tol m_mul m_tol m_mul def } if
	n_g2 n_g1 m_sub m_abs n_itol m_gt {
		/n_mid n_ia n_ib m_add m_two m_div def
		n_ia n_mid 1 n_irec  n_mid n_ib 1 n_irec  m_add
	}{ n_g2 } ifelse
	end m_unguard m_fin end
} bind def

% ---------------------------------------------------------------- polynomials
% A polynomial is an array of coefficients, highest power first:
% [1 0 -2] is x^2 - 2.

%p x polyval -> p(x)   (x a number, bignum, string, or complex [re im])
/polyval {
	dup type /arraytype eq { dup length 2 eq }{ false } ifelse {
		6 dict begin
		/n_x exch def /n_P exch def
		[ 0 0 ] n_P { exch n_x cmul exch cadd } forall
		end
	}{
		2 copy m_isstrbn exch n_hasbn or m_ops begin m_guard
		6 dict begin
		/n_x exch m_cv def /n_P exch def
		m_zero n_P { exch n_x m_mul exch m_cv m_add } forall
		end m_unguard m_fin end
	} ifelse
} bind def

/polyder { % p -> derivative
	dup n_hasbn m_ops begin
	6 dict begin
	/n_P exch def /n_n n_P length 1 sub def
	n_n 0 le { [ m_zero ] }{
		[ 0 1 n_n 1 sub { /n_i exch def n_P n_i get m_cv n_n n_i sub m_cv m_mul } for ]
	} ifelse
	end end
} bind def

/polyadd { % p q -> p + q
	2 copy n_hasbn exch n_hasbn or m_ops begin
	8 dict begin
	/n_Q exch def /n_P exch def
	/n_n n_P length n_Q length 2 copy lt { exch } if pop def
	[ 0 1 n_n 1 sub { /n_i exch def
		n_i n_n n_P length sub sub dup 0 ge { n_P exch get m_cv }{ pop m_zero } ifelse
		n_i n_n n_Q length sub sub dup 0 ge { n_Q exch get m_cv }{ pop m_zero } ifelse
		m_add
	} for ]
	end end
} bind def

/polymul { % p q -> p x q
	2 copy n_hasbn exch n_hasbn or m_ops begin
	8 dict begin
	/n_Q exch def /n_P exch def
	/n_r [ n_P length n_Q length add 1 sub { m_zero } repeat ] def
	0 1 n_P length 1 sub { /n_i exch def
		0 1 n_Q length 1 sub { /n_j exch def
			n_r n_i n_j add  n_r n_i n_j add get n_P n_i get m_cv n_Q n_j get m_cv m_mul m_add  put
		} for
	} for
	n_r
	end end
} bind def

/n_cmul { % ar ai br bi -> re im   (ops dict current)
	4 dict begin /n_bi exch def /n_br exch def /n_ai exch def /n_ar exch def
	n_ar n_br m_mul n_ai n_bi m_mul m_sub  n_ar n_bi m_mul n_ai n_br m_mul m_add
	end
} bind def
/n_cdiv { % ar ai br bi -> re im
	5 dict begin /n_bi exch def /n_br exch def /n_ai exch def /n_ar exch def
	/n_d n_br n_br m_mul n_bi n_bi m_mul m_add def
	n_ar n_br m_mul n_ai n_bi m_mul m_add n_d m_div
	n_ai n_br m_mul n_ar n_bi m_mul m_sub n_d m_div
	end
} bind def

%p polyroots -> [ [re im] ... ]   all complex roots, sorted by real part
% Durand-Kerner iteration. Multiple roots converge slowly and are only
% accurate to about 1/m of the digits for a root of multiplicity m.
/polyroots {
	dup n_hasbn m_ops begin m_guard
	30 dict begin
	/n_P0 exch def
	/n_c [ n_P0 { m_cv } forall ] def
	/n_s 0 def
	{ n_s n_c length ge { exit } if n_c n_s get m_isz not { exit } if /n_s n_s 1 add def } loop
	n_s n_c length ge { n_P0 end m_unguard end /polyroots errordict /rangecheck get exec } if
	/n_c n_c n_s n_c length n_s sub getinterval def
	/n_n n_c length 1 sub def
	n_n 0 eq { [ ] }{
		/n_a [ n_c { n_c 0 get m_div } forall ] def        % monic
		m_zero n_a { m_abs n_max } forall m_one m_add /n_R exch def   % roots lie within n_R
		/n_Rr n_R dup type /arraytype eq { bncvr } if def
		/n_zr n_n array def /n_zi n_n array def
		0 1 n_n 1 sub { /n_k exch def
			/n_th 360 n_k mul n_n div 23 add def
			n_zr n_k n_Rr n_th cos mul m_cv put
			n_zi n_k n_Rr n_th sin mul m_cv put
		} for
		/n_tol2 m_tol dup m_mul def
		/n_floor2 n_R m_tol m_mul dup m_mul def
		/n_it 0 def
		{
			/n_conv true def
			0 1 n_n 1 sub { /n_k exch def
				/n_xr n_zr n_k get def /n_xi n_zi n_k get def
				/n_pr m_one def /n_pim m_zero def
				1 1 n_n { /n_j exch def
					n_pr n_pim n_xr n_xi n_cmul exch n_a n_j get m_add exch
					/n_pim exch def /n_pr exch def
				} for
				/n_dr m_one def /n_di m_zero def
				0 1 n_n 1 sub { /n_j exch def n_j n_k ne {
					n_dr n_di  n_xr n_zr n_j get m_sub  n_xi n_zi n_j get m_sub  n_cmul
					/n_di exch def /n_dr exch def
				} if } for
				n_dr m_isz n_di m_isz and { /n_dr m_tol def } if
				n_pr n_pim n_dr n_di n_cdiv /n_ddi exch def /n_ddr exch def
				n_zr n_k n_xr n_ddr m_sub put
				n_zi n_k n_xi n_ddi m_sub put
				/n_dd n_ddr n_ddr m_mul n_ddi n_ddi m_mul m_add def
				/n_zz n_zr n_k get dup m_mul n_zi n_k get dup m_mul m_add n_floor2 n_max def
				n_dd n_zz n_tol2 m_mul m_gt { /n_conv false def } if
			} for
			/n_it n_it 1 add def
			n_conv n_it 500 gt or { exit } if
		} loop
		% parts below the working accuracy become exactly 0
		/n_cf m_one type /integertype eq { 10 }{ 1000 } ifelse m_cv def
		/n_cf2 n_cf n_cf m_mul n_tol2 m_mul def
		0 1 n_n 1 sub { /n_k exch def
			/n_lim n_zr n_k get dup m_mul n_zi n_k get dup m_mul m_add n_floor2 n_max n_cf2 m_mul def
			n_zi n_k get dup m_mul n_lim m_gt not { n_zi n_k 0.0 m_cv put } if
			n_zr n_k get dup m_mul n_lim m_gt not { n_zr n_k 0.0 m_cv put } if
		} for
		% sort by real part, then imaginary part
		/n_idx [ 0 1 n_n 1 sub { } for ] def
		/n_eq2 n_R n_R m_mul n_cf2 m_mul def
		1 1 n_n 1 sub { /n_k exch def
			/n_cur n_idx n_k get def /n_j n_k 1 sub def
			{ n_j 0 lt { exit } if
			  /n_o n_idx n_j get def
			  /n_dre n_zr n_o get n_zr n_cur get m_sub def
			  /n_same n_dre dup m_mul n_eq2 m_gt not def
			  n_same { n_zi n_o get n_zi n_cur get m_gt }{ n_dre m_isneg not } ifelse
			  not { exit } if
			  n_idx n_j 1 add n_o put /n_j n_j 1 sub def
			} loop
			n_idx n_j 1 add n_cur put
		} for
		[ n_idx { /n_k exch def [ n_zr n_k get n_zi n_k get ] } forall ]
	} ifelse
	end m_unguard
	[ exch { aload pop m_fin exch m_fin exch 2 array astore } forall ]
	end
} bind def

%[x...] [y...] d polyfit -> p   least-squares polynomial of degree d
/polyfit {
	3 copy pop n_hasbn exch n_hasbn or m_ops begin m_guard
	12 dict begin
	/n_d exch def /n_Y exch def /n_X exch def
	n_X length n_Y length ne  n_d 0 lt or  n_d 1 add n_X length gt or {
		n_X n_Y n_d end m_unguard end /polyfit errordict /rangecheck get exec
	} if
	/n_m n_X length def
	/n_A n_m n_d 1 add marray def /n_B n_m 1 marray def
	1 1 n_m { /n_i exch def
		/n_x n_X n_i 1 sub get m_cv def
		/n_pw m_one def
		n_d 1 add -1 1 { /n_j exch def n_A n_i n_j n_pw mput /n_pw n_pw n_x m_mul def } for
		n_B n_i 1 n_Y n_i 1 sub get m_cv mput
	} for
	n_A n_B mlstsq 0 get
	end m_unguard
	[ exch { m_fin } forall ]
	end
} bind def

end % tx@PostScriptMathDict

%%EOF
