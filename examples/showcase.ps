% Build the PDF with make_showcase.bat, or from the folder source/
% (Load.ps loads the parts from the current folder):
%   gswin64c -q -dNOSAFER -dBATCH -dNOPAUSE -sDEVICE=pdfwrite
%            -sOutputFile=../examples/showcase.pdf ../examples/showcase.ps
%
% Every "Code" column entry below is a string that is executed as written;
% the "Result" column is whatever it leaves on the stack (or the error it
% raises), so the document always matches the library.

(Load.ps) run

/pdfmark where { pop }{ userdict /pdfmark /cleartomark load put } ifelse
[ /Title (pst-numeric: function showcase)
  /Author (Buddy Ledger)
  /Subject (Arbitrary-precision decimals, CORDIC trig and matrices in PostScript)
  /DOCINFO pdfmark

% ---------------------------------------------------------------- layout
/sc_L 54 def /sc_R 558 def /sc_W sc_R sc_L sub def
/sc_top 738 def /sc_bot 60 def
/sc_page 1 def /sc_y sc_top def
/sc_fs 8.5 def /sc_chw sc_fs 0.6 mul def        % Courier advance = 0.6 em
/sc_lead 11 def
/sc_cw 40 def                                    % code column, characters
/sc_rx sc_L sc_cw sc_chw mul add 12 add def      % result column x
/sc_rchars sc_R sc_rx sub sc_chw div cvi def     % result column, characters
/sc_allchars sc_W sc_chw div cvi def

/sc_accent { 0.11 0.33 0.62 setrgbcolor } def
/sc_warm   { 0.80 0.38 0.10 setrgbcolor } def
/sc_red    { 0.72 0.11 0.11 setrgbcolor } def
/sc_ink    { 0.12 setgray } def
/sc_muted  { 0.42 setgray } def

/sc_min { 2 copy gt { exch } if pop } def
/sc_max { 2 copy lt { exch } if pop } def
/sc_font { exch findfont exch scalefont setfont } def

/sc_footer {
	/Helvetica 8 sc_font sc_muted
	sc_L 34 moveto (pst-numeric  \267  function showcase) show
	(Page ) sc_page 4 string cvs mergestr
	dup stringwidth pop sc_R exch sub 34 moveto show
	sc_ink
} def
/sc_newpage { sc_footer showpage /sc_page sc_page 1 add def /sc_y sc_top def } def
/sc_need { sc_y exch sub sc_bot lt { sc_newpage } if } def
/sc_down { /sc_y exch sc_y exch sub def } def
/sc_rule { % gray
	setgray 0.5 setlinewidth sc_L sc_y moveto sc_R sc_y lineto stroke sc_ink
} def

% ---------------------------------------------------------------- text
/sc_h1 { % (title)
	sc_y sc_top lt { 70 sc_need } if
	sc_y sc_top lt { 14 sc_down } if
	[ /Title 2 index /Page sc_page /OUT pdfmark
	/Helvetica-Bold 16 sc_font sc_accent
	sc_L sc_y 14 sub moveto show
	22 sc_down 0.75 sc_rule 12 sc_down sc_ink
} def
/sc_h2plain { % (title)   subheading only
	40 sc_need 6 sc_down
	/Helvetica-Bold 10.5 sc_font sc_ink
	sc_L sc_y 9 sub moveto show
	14 sc_down
} def
/sc_h2 { sc_h2plain sc_labels } def   % (title)   subheading with column labels
/sc_labels { % CODE / RESULT column labels
	/Helvetica-Bold 7.5 sc_font sc_muted
	sc_L sc_y 7 sub moveto (CODE) show sc_rx sc_y 7 sub moveto (RESULT) show
	10 sc_down 0.8 sc_rule 3 sc_down sc_ink
} def
/sc_wrap { % (text) width -> [ (line) ... ]   word wrap in the current font
	/sc_ww exch def /sc_rest exch def /sc_acc () def
	[
	{
		sc_rest ( ) search
		{ /sc_word exch def pop /sc_rest exch def }
		{ /sc_word exch def /sc_rest () def } ifelse
		sc_acc length 0 eq { sc_word }{ sc_acc ( ) mergestr sc_word mergestr } ifelse
		dup stringwidth pop sc_ww gt sc_acc length 0 gt and
		{ pop sc_acc /sc_acc sc_word def }{ /sc_acc exch def } ifelse
		sc_rest length 0 eq { exit } if
	} loop
	sc_acc ]
} def
/sc_para { % (text)  wrapped body text
	/Helvetica 9.5 sc_font sc_ink
	sc_W sc_wrap { sc_paraline } forall 5 sc_down
} def
/sc_paraline { % font is set after any page break, which changes it
	13 sc_need /Helvetica 9.5 sc_font sc_ink
	sc_L sc_y 10 sub moveto show 13 sc_down
} def

% ---------------------------------------------------------------- results
/sc_fmtmatrix { % M -> (a b; c d)
	/sc_M exch def sc_M msize /sc_nc exch def /sc_nr exch def
	([) 1 1 sc_nr { /sc_i exch def
		1 1 sc_nc { /sc_j exch def
			sc_M sc_i sc_j mget dup typchk (bignumtype) eq { bncvs }{ 30 string cvs } ifelse mergestr
			sc_j sc_nc lt { ( ) mergestr } if
		} for
		sc_i sc_nr lt { (; ) mergestr } if
	} for (]) mergestr
} def
/sc_listmode false def
/sc_rowl { /sc_listmode true def sc_row /sc_listmode false def } def   % as sc_row, result shown as a list
/sc_fmtlist { % [a b ...] -> ([a, b, ...])
	/sc_listmode false def
	([) exch true exch {
		exch { }{ exch (, ) mergestr exch } ifelse sc_fmt mergestr false
	} forall pop (]) mergestr
} def
/sc_fmt { % any -> string
	sc_listmode 1 index type /arraytype eq and { sc_fmtlist }{
	dup typchk (bignumtype) eq { bncvs }{
	dup typchk (complextype) eq { ccvs }{
	dup typchk (matrixtype) eq { sc_fmtmatrix }{
	dup type /arraytype eq 1 index xcheck not and { sc_fmtlist }{
	dup type /stringtype eq { (\() exch mergestr (\)) mergestr }{
	dup type /nametype eq { dup xcheck { 60 string cvs }{ (/) exch 60 string cvs mergestr } ifelse }{
	60 string cvs } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse
} def
/sc_chunks { % (str) n -> [ (piece) ... ]
	/sc_n exch def /sc_s exch def
	sc_s length 0 eq { [ () ] }{
	[ 0 sc_n sc_s length 1 sub {
		sc_s exch dup sc_n add sc_s length sc_min 1 index sub getinterval } for ]
	} ifelse
} def

/sc_row { % (code) (note)   run code, typeset code, result and note
	/sc_note exch def /sc_code exch def
	countdictstack /sc_dc exch def
	mark sc_code cvx stopped
	{ cleartomark countdictstack sc_dc sub { end } repeat
	  (error: /) $error /errorname get 40 string cvs mergestr /sc_err true def }
	{ counttomark dup 0 eq { pop pop (no result) /sc_none true def }{
		array astore exch pop
		() exch { sc_fmt 1 index length 0 gt { exch (   ) mergestr exch } if mergestr } forall
		/sc_none false def } ifelse
	  /sc_err false def } ifelse
	/sc_res exch def
	/sc_rl sc_res sc_rchars sc_chunks def
	sc_code length sc_cw le {
		/sc_cl [ sc_code ] def /sc_split false def
	}{
		/sc_cl sc_code sc_allchars sc_chunks def /sc_split true def
	} ifelse
	/Helvetica-Oblique 8 sc_font
	/sc_nl sc_note length 0 eq { [ ] }{ sc_note sc_W sc_wrap } ifelse def
	sc_split { sc_cl length sc_rl length add }{ sc_rl length } ifelse
	sc_lead mul sc_nl length 10 mul add 6 add sc_need
	/Courier sc_fs sc_font
	sc_y
	sc_muted sc_cl { sc_L sc_y 8 sub moveto show sc_split { sc_lead sc_down } if } forall
	sc_split not { /sc_y exch def }{ pop } ifelse
	sc_err { sc_red }{ sc_none { sc_muted }{ sc_accent } ifelse } ifelse
	sc_rl { sc_rx sc_y 8 sub moveto show sc_lead sc_down } forall
	/Helvetica-Oblique 8 sc_font 0.30 setgray
	sc_nl { sc_L sc_y 7 sub moveto show 10 sc_down } forall
	sc_ink 3 sc_down 0.9 sc_rule 2 sc_down
} def

% ================================================================ page 1
/sc_title {
	/Helvetica-Bold 24 sc_font sc_ink
	sc_L sc_y 22 sub moveto (pst-numeric) show
	32 sc_down
	/Helvetica 13 sc_font sc_muted
	sc_L sc_y 12 sub moveto (Function showcase) show
	24 sc_down 0.75 sc_rule 14 sc_down
} def
sc_title

(This document shows every public procedure of pst-numeric with a live result. Each row has three parts. The Code column, in gray, is PostScript that is executed exactly as written while the document is generated. The Result column, in blue, is what that code leaves on the operand stack. The note in italics underneath explains what the row shows and why the result is what it is.) sc_para
(Results in red are errors, and every one of them is deliberate: those rows feed a procedure bad input, such as a division by zero or the logarithm of a negative number, to show that it refuses with a standard PostScript error instead of returning a wrong answer. Rows marked no result are procedures that change a setting or print to the console rather than leave a value.) sc_para
(Because every result is computed while the PDF is built by showcase.ps, the document always matches the library.) sc_para
(The library has five parts: bignumlibrary.ps for decimal numbers with any number of significant digits, Trig.ps for CORDIC trigonometry on ordinary PostScript reals, Matrix.ps for linear algebra, Complex.ps for complex numbers, and Numeric.ps for roots, integrals and polynomials. Matrix.ps, Complex.ps and Numeric.ps work on ordinary reals or on bignums. All five are loaded with \(Load.ps\) run.) sc_para
(Generated with ) product mergestr ( ) mergestr
revision 100 idiv 10 string cvs mergestr (.) mergestr
revision 100 mod dup 10 lt { exch (0) mergestr exch } if 10 string cvs mergestr
